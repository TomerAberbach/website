---
import { build } from 'esbuild'
import { filter, first, get, map, pipe } from 'lfi'
import HomeWidgets from '~/components/home-widgets.tsx'
import Layout from '~/layouts/layout.astro'
import { getGraph } from '~/services/graph.ts'
import { getHomeData } from '~/services/home-state.ts'
import { SITE_DESCRIPTION, SITE_TITLE_AND_AUTHOR } from '~/services/meta.ts'
import { rootPath } from '~/services/path.ts'
import { getOrderedPosts } from '~/services/ordered.ts'
import type { MarkdownPost, Post } from '~/services/post.ts'

const [posts, graph] = await Promise.all([getOrderedPosts(), getGraph()])

const data = getHomeData(posts.keys(), graph)
const latestPost: MarkdownPost = pipe(
  posts,
  map(([, post]: [string, Post]) => post),
  filter(post => post.type === `markdown`),
  first,
  get,
)

// The script that paints the page in the URL's state before hydration must
// run before the body is parsed, so it is bundled and inlined into the head.
const {
  outputFiles: [preloadScript],
} = await build({
  entryPoints: [rootPath(`src/scripts/home-preload.ts`)],
  tsconfig: rootPath(`tsconfig.json`),
  bundle: true,
  minify: true,
  write: false,
  format: `iife`,
  globalName: `homePreload`,
})
const preloadData = JSON.stringify(data).replaceAll(`<`, `\\u003c`)
---

<Layout
  title={SITE_TITLE_AND_AUTHOR}
  description={SITE_DESCRIPTION}
  post={latestPost}
  type='website'
>
  <Fragment slot='head'>
    <script
      is:inline
      data-astro-rerun
      set:html={`${preloadScript!.text}homePreload.default(${preloadData})`}
    ></script>
  </Fragment>
  <HomeWidgets client:load data={data} graph={graph} />
</Layout>
