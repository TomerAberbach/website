{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/*.ts",
    "src/scripts/*.ts",
    "src/test/*.{ts,tsx}",
    "types/*.d.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.ts", "*.{ts,js}"],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/typography",
    "glyphhanger",
    "start-server-and-test"
  ],
  "ignoreBinaries": []
}
