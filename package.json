    "@rtsao/scc": "^1.1.0",
    "@shikijs/rehype": "^4.4.3",
    "clsx": "^2.1.1",
    "colortranslator": "^6.1.1",
    "compression": "^1.8.2",
    "cssesc": "^3.0.0",
    "escape-goat": "^4.0.0",
    "escape-string-regexp": "^5.0.0",
