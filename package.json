{
  "private": true,
  "name": "website",
  "author": {
    "name": "Tomer Aberbach",
    "email": "tomer@aberba.ch",
    "url": "https://tomeraberba.ch"
  },
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "prepare": "playwright install --with-deps chromium webkit",
    "format:base": "prettier --cache --write",
    "format": "pnpm format:base .",
    "lint:base": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "lint": "pnpm lint:base .",
    "typecheck:react-router": "react-router typegen",
    "typecheck:tomer": "tsc --noEmit",
    "typecheck": "run-s 'typecheck:*'",
    "knip": "knip",
    "test": "vitest",
    "test:node": "vitest --project node",
    "test:browser": "vitest --project browser",
    "coverage": "vitest --coverage",
    "check": "run-p -lc check:heavy check:light",
    "check:heavy": "run-s \"test:node --run\" \"test:browser --run\"",
    "check:light": "run-s -c typecheck \"lint --no-fix\" \"format --no-write --check\" knip",
    "build": "NODE_ENV=production node scripts/build.ts",
    "dev": "PANGOCAIRO_BACKEND=fontconfig FONTCONFIG_PATH=private/fonts react-router dev",
    "start": "node server.ts",
    "deploy": "fly deploy --remote-only"
  },
  "prettier": "@tomer/prettier-config",
  "dependencies": {
    "@bramus/style-observer": "^2.0.2",
    "@epic-web/invariant": "^1.0.0",
